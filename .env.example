# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real credentials.
#
#   cp .env.example .env
#
# These same six variables are what the GitHub Actions scraper and the Vercel
# deployment expect, configured as secrets / environment variables on each side.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=newsanalyser

# Set to 1 for any hosted provider that requires TLS (Railway, Aiven, PlanetScale…).
# Leave blank/commented for a local MySQL server.
# DB_SSL=1

# ---------------------------------------------------------------------------
# Optional: single-URL alternative
# ---------------------------------------------------------------------------
# If you prefer one variable over five, DB_URL takes precedence when it is set.
# Uncomment and delete the five DB_* lines above if you use this.
#
# DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/newsanalyser
