# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real credentials.
#
#   cp .env.example .env
#
# This same variable is what the GitHub Actions scraper and the Vercel
# deployment expect, configured as a secret / environment variable on each side.

# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------
# Connection string from the Neon console → Connect → Connection string.
# Use the *pooled* host (ends in `-pooler`) for the app and the scraper.
#
#   local:      .env
#   GitHub:     repository secret DATABASE_URL
#   Vercel:     project environment variable DATABASE_URL
#
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
